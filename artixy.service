[Unit]
Description=artixy - Artix VM Discord bot (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/artixy
# Token lives in ~/.config/artixy/config.jsonc; .env is optional overrides.
EnvironmentFile=-%h/artixy/.env
ExecStart=%h/artixy/artixy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
