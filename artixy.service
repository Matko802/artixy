[Unit]
Description=artixy - Artix VM Discord bot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/artixy
# Dash prefix = optional: unit must not fail with 'Result: resources'
# when the file is absent (token lives in ~/.config/artixy/config.toml).
EnvironmentFile=-%h/artixy/.env
ExecStart=%h/artixy/target/release/artixy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
